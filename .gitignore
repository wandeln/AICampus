# Third-Party-Libs (minified) — für Code-Suchen unsichtbar machen.
# Die Dateien bleiben in Git getrackt (Git selbst ignoriert .gitignore
# bei getrackten Dateien), der Search-Tool überspringt sie aber trotzdem.
static/vendor/*.js
static/vendor/katex/
static/vendor/codemirror/
static/vendor/reveal/reveal.js
static/vendor/reveal/reveal.css
static/vendor/reveal/reset.css
static/vendor/reveal/plugin/notes/